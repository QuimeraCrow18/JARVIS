# ═══════════════════════════════════════════════════════
# JOSAMICK ECOSYSTEM — CONFIGURACION GLOBAL
# Copia este archivo como .env y ajusta los valores.
# ═══════════════════════════════════════════════════════

# ─── Claves Maestras ──────────────────────────────────
JOSAMICK_MASTER_KEY=clave_local
KEXPLER_MASTER_KEY=clave_kexpler
C2_ADMIN_KEY=JOSAMICK_C2_ADMIN

# ─── C2 Gateway ───────────────────────────────────────
C2_HOST=0.0.0.0
C2_PORT=9090

# ─── Brain Intelligence ───────────────────────────────
JOSAMICK_HOST=0.0.0.0
JOSAMICK_PORT=5001
JOSAMICK_NODE_MODE=cloud

# ─── Dashboard UI ─────────────────────────────────────
KEXPLER_HOST=0.0.0.0
KEXPLER_PORT=5002

# ─── Auth Service ─────────────────────────────────────
AUTH_HOST=0.0.0.0
AUTH_PORT=8001
AUTH_DB_PATH=/app/data/users/auth.db
AUTH_JWT_SECRET=changeme_jwt_secret_256bits

# ─── Email Service ────────────────────────────────────
EMAIL_HOST=0.0.0.0
EMAIL_PORT=8002
SMTP_SERVER=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notificaciones@kexpler.com
FROM_NAME=Kexpler Network

# ─── Endpoints Internos ───────────────────────────────
C2_ENDPOINT=http://c2_gateway:9090
AUTH_ENDPOINT=http://auth:8001
EMAIL_ENDPOINT=http://email:8002
BRAIN_ENDPOINT=http://brain:5001
