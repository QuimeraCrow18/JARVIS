# Entorno JOSAMICK Ecosystem - Configuracion Dinamica
# Copia este archivo como .env y ajusta los valores

# --- Nodo Cerebro (JOSAMICK) ---
JOSAMICK_HOST=0.0.0.0
JOSAMICK_PORT=5001
JOSAMICK_MASTER_KEY=clave_local

# --- Nodo Gateway (KEXPLER) ---
KEXPLER_HOST=0.0.0.0
KEXPLER_PORT=5002
KEXPLER_MASTER_KEY=clave_kexpler

# --- Nodo Boveda (CORE_SHARED) ---
CORE_DB_PATH=/data/kexpler_cloud.db
CORE_LOG_LEVEL=info

# --- C2 Dashboard ---
C2_HOST=0.0.0.0
C2_PORT=9090
C2_ADMIN_KEY=JOSAMICK_C2_ADMIN
C2_AUTO_REFRESH=0

# --- Oceanic Shield ---
OCEANIC_ALGORITHM=AESGCM
OCEANIC_KEY_BITS=256

# --- Security Guard ---
SECURITY_GUARD_ACTIVE=true
ADMIN_PUBLIC_KEY_PATH=
C2_ENDPOINT=http://c2:9090

# --- Base de Datos ---
DB_HOST=db
DB_PORT=5432
DB_NAME=josamick
DB_USER=admin
DB_PASS=secret

# --- Service Discovery ---
SERVICE_DISCOVERY_URL=http://discovery:8500
JOSAMICK_SERVICE=cerebro:5001
KEXPLER_SERVICE=gateway:5002
C2_SERVICE=c2:9090

# --- Circuit Breaker ---
CB_TIMEOUT=5
CB_MAX_RETRIES=3
CB_RECOVERY_INTERVAL=30
